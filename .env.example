# Copia este archivo como ".env" y pon tu API key de Google AI Studio
# https://aistudio.google.com/apikey
GEMINI_API_KEY=pon_aqui_tu_api_key
# "gemini-flash-latest" siempre apunta al Flash más reciente. Corre
# "python probar_api.py" para ver la lista exacta de modelos de tu cuenta.
GEMINI_MODEL=gemini-3.5-flash-lite
